#!/bin/sh
# Low battery notifications (UPower itself hibernates/powers off at 2%).
LOW=20 CRIT=10
BAT=$(ls -d /sys/class/power_supply/BAT* 2>/dev/null | head -1)
[ -n "$BAT" ] || exit 0
warned=100

while :; do
	cap=$(cat "$BAT/capacity") st=$(cat "$BAT/status")
	if [ "$st" != Discharging ]; then
		warned=100
	elif [ "$cap" -le "$CRIT" ] && [ "$warned" -gt "$CRIT" ]; then
		notify-send -u critical -i battery-caution "Akku fast leer: $cap%" "Netzteil anschließen"
		warned=$CRIT
	elif [ "$cap" -le "$LOW" ] && [ "$warned" -gt "$LOW" ]; then
		notify-send -i battery-low "Akku niedrig: $cap%"
		warned=$LOW
	fi
	sleep 60
done
