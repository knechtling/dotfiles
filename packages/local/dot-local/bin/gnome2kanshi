#!/usr/bin/env python3
"""Convert GNOME's saved monitor layouts (~/.config/monitors.xml) to kanshi.

  gnome2kanshi            print kanshi config to stdout
  gnome2kanshi --check    (inside dwl/sway) compare connected outputs with
                          the generated criteria and show mismatches

External monitors are matched by "Make Model Serial" as wlroots reports it:
GNOME stores the 3-letter PNP vendor code, wlroots the vendor name from the
PNP registry (same table as systemd's hwdb), so the code is resolved there.
The internal panel is matched by connector name (eDP-1).
"""
import json
import re
import subprocess
import sys
import xml.etree.ElementTree as ET
from pathlib import Path

MONITORS = Path.home() / ".config/monitors.xml"
HWDB = Path("/usr/lib/udev/hwdb.d/20-acpi-vendor.hwdb")


def pnp_names():
    names, key = {}, None
    for line in HWDB.read_text(errors="replace").splitlines():
        m = re.fullmatch(r"acpi:([A-Z@]{3})\*:", line)
        if m:
            key = m.group(1)
        elif key and "ID_VENDOR_FROM_DATABASE=" in line:
            names.setdefault(key, line.split("=", 1)[1].strip())
            key = None
    return names


def serial(s):
    # mutter prints numeric EDID serials as lowercase hex, wlroots uppercase;
    # a zero serial is absent for wlroots (kanshi: "Unknown")
    if re.fullmatch(r"0x[0-9a-fA-F]+", s or ""):
        return "Unknown" if int(s, 16) == 0 else "0x%08X" % int(s, 16)
    return s or "Unknown"


def criteria(spec, pnp):
    conn = spec.findtext("connector")
    if conn.startswith("eDP"):  # X11-era GNOME configs say "eDP"
        return "eDP-1"
    vendor = spec.findtext("vendor")
    make = pnp.get(vendor, vendor)
    return f"{make} {spec.findtext('product')} {serial(spec.findtext('serial'))}"


def profiles():
    pnp = pnp_names()
    seen, result = set(), []
    for conf in ET.parse(MONITORS).getroot().findall("configuration"):
        outs = []
        for lm in conf.findall("logicalmonitor"):
            for mon in lm.findall("monitor"):
                spec, mode = mon.find("monitorspec"), mon.find("mode")
                outs.append({
                    "crit": criteria(spec, pnp),
                    "model": spec.findtext("product"),
                    "mode": "%sx%s@%.3fHz" % (mode.findtext("width"),
                                              mode.findtext("height"),
                                              float(mode.findtext("rate"))),
                    "pos": f"{lm.findtext('x')},{lm.findtext('y')}",
                    "scale": "%g" % round(float(lm.findtext("scale")), 4),
                })
        disabled = [criteria(d.find("monitorspec"), pnp)
                    for d in conf.findall("disabled")]
        # the laptop panel stays connected with the lid closed, so a profile
        # without it never matches; lid-watch turns eDP-1 off instead
        if not any(o["crit"] == "eDP-1" for o in outs):
            continue
        key = frozenset([o["crit"] for o in outs] + disabled)
        if key in seen:  # same monitors, other connector (dock) -> keep first
            continue
        seen.add(key)
        result.append((outs, disabled))
    # most specific (most outputs) first; kanshi takes the first match
    result.sort(key=lambda p: -(len(p[0]) + len(p[1])))
    return result


def slug(crit):
    return re.sub(r"[^a-z0-9]+", "-", crit.lower()).strip("-")[:24]


def render():
    lines = ["# generated by gnome2kanshi from ~/.config/monitors.xml",
             "# edit freely; rerun gnome2kanshi --check inside dwl to verify", ""]
    used = set()
    for outs, disabled in profiles():
        ext = sorted(slug(o["model"]) for o in outs if o["crit"] != "eDP-1")
        name = "_".join(ext) if ext else "laptop"
        if name in used:  # same models, different units (e.g. two LG 4K)
            name += f"_{len(used)}"
        used.add(name)
        lines.append(f"profile {name} {{")
        for o in outs:
            lines.append(f'\toutput "{o["crit"]}" enable mode {o["mode"]} '
                         f'position {o["pos"]} scale {o["scale"]}')
        for d in disabled:
            lines.append(f'\toutput "{d}" disable')
        lines += ["}", ""]
    return "\n".join(lines)


def check():
    try:
        heads = json.loads(subprocess.run(["wlr-randr", "--json"], check=True,
                                          capture_output=True, text=True).stdout)
    except (OSError, subprocess.CalledProcessError, ValueError) as e:
        sys.exit(f"wlr-randr --json failed (run this inside dwl): {e}")
    known = {o["crit"] for outs, dis in profiles() for o in outs} | \
            {d for _, dis in profiles() for d in dis}
    for h in heads:
        desc = " ".join(h.get(k) or "Unknown" for k in ("make", "model", "serial"))
        ok = h["name"] in known or desc in known
        print(f"{'OK  ' if ok else 'MISS'} {h['name']:10} {desc}")
    print("\nMISS = no profile uses this output; fix the criteria in ~/.config/kanshi/config")


if __name__ == "__main__":
    check() if "--check" in sys.argv else print(render())
