#!/bin/sh
# Pipe terminal scrollback into a menu prompt of recent commands,
# allowing the user to copy the output of one.
# Requires: wmenu, wl-clipboard

tmpfile=$(mktemp /tmp/cmd-output.XXXXXX)
trap 'rm -f "$tmpfile"' 0 1 15

cat >"$tmpfile"
sed -i 's/\x0//g' "$tmpfile"

# try to detect last prompt marker
ps1="$(grep "\S" "$tmpfile" | tail -n 1 | sed 's/^\s*//' | cut -d' ' -f1)"

chosen="$(grep -F "$ps1" "$tmpfile" |
  sed '$ d' | tac |
  wmenu -p "Copy which command's output?" -l 10 |
  sed 's/[^^]/[&]/g; s/\^/\\^/g')"

eps1="$(echo "$ps1" | sed 's/[^^]/[&]/g; s/\^/\\^/g')"

awk "/^$chosen$/{p=1;print;next} p&&/$eps1/{p=0};p" "$tmpfile" | wl-copy
