#!/bin/sh

# System action helper using wmenu for Wayland sessions.
set -eu

if [ -n "${SWAYSOCK:-}" ]; then
  WM="sway"
else
  WM="dwl"
fi
export WM
STOPFILE="${XDG_CACHE_HOME:-$HOME/.cache}/dwl-stop"

case "$(readlink -f /sbin/init)" in
*systemd*) ctl='systemctl' ;;
*) ctl='loginctl' ;;
esac

notify() {
  msg=$1
  if command -v notify-send >/dev/null 2>&1; then
    notify-send "sysact" "$msg"
  else
    printf 'sysact: %s\n' "$msg" >&2
  fi
}

need_cmd() {
  for cmd in "$@"; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
      notify "Missing dependency: $cmd"
      exit 1
    fi
  done
}

need_cmd notify-send pstree wmenu "$ctl"

lock() {
  if command -v waylock >/dev/null 2>&1; then
    waylock
  else
    need_cmd swaylock
    swaylock -f
  fi
}

can() {
  [ "$(busctl call org.freedesktop.login1 /org/freedesktop/login1 \
    org.freedesktop.login1.Manager "Can$1" 2>/dev/null)" = 's "yes"' ]
}

wmpid() {
  tree="$(pstree -ps $$)"
  tree="${tree#*$WM\(}"
  printf '%s\n' "${tree%%\)*}"
}

menu_items="🔒 lock
🚪 leave $WM
♻️ renew $WM"
can Hibernate && menu_items="$menu_items
🐻 hibernate"
menu_items="$menu_items
🔃 reboot
🖥️ shutdown
💤 sleep"

choice="$(printf '%s\n' "$menu_items" | wmenu -i -p 'Action: ')"

case "$choice" in
'🔒 lock')
  lock
  ;;
"🚪 leave $WM")
  if [ "$WM" = sway ]; then
    swaymsg exit
    exit
  fi
  pid="$(wmpid)"
  mkdir -p "$(dirname "$STOPFILE")"
  : >"$STOPFILE"
  kill -TERM "$pid"
  ;;
"♻️ renew $WM")
  if [ "$WM" = sway ]; then
    swaymsg reload
    exit
  fi
  pid="$(wmpid)"
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    kill -USR1 "$pid"
  else
    notify "Unable to find running $WM process."
  fi
  ;;
'🐻 hibernate')
  $ctl hibernate
  lock
  ;;
'💤 sleep')
  $ctl suspend -i
  lock
  ;;
'🔃 reboot') $ctl reboot ;;
'🖥️ shutdown') $ctl poweroff ;;
# '📺 display off') xset dpms force off ;;
*) exit 1 ;;
esac
