#!/bin/sh
# Idle actions for swayidle (GNOME-like: dim, screen off, suspend on battery).
#   idle-ctl dim|undim|off|on|suspend
BAT_DIM=30 # percent
MARK="${XDG_RUNTIME_DIR:-/tmp}/idle-ctl.dimmed"

on_battery() {
	for ac in /sys/class/power_supply/A[CD]*/online; do
		[ -r "$ac" ] && [ "$(cat "$ac")" = 1 ] && return 1
	done
	return 0
}

case "$1" in
dim)
	ls /sys/class/backlight/* >/dev/null 2>&1 || exit 0
	cur=$(brightnessctl -m | cut -d, -f4 | tr -d %)
	# Remember that *we* dimmed: undim must not restore a stale saved value
	# when the user already sat below BAT_DIM and nothing was dimmed.
	if [ "${cur:-0}" -gt "$BAT_DIM" ]; then
		brightnessctl -q -s set "$BAT_DIM%" && : >"$MARK"
	fi
	;;
undim)
	[ -e "$MARK" ] || exit 0
	rm -f "$MARK"
	brightnessctl -q -r 2>/dev/null
	;;
off) command -v wlopm >/dev/null && wlopm --off '*' ;;
on) command -v wlopm >/dev/null && wlopm --on '*' ;;
suspend)
	# GNOME default: suspend when idle on battery, never on AC
	on_battery && systemctl suspend
	;;
*) echo "usage: ${0##*/} dim|undim|off|on|suspend" >&2; exit 2 ;;
esac
exit 0
