#!/bin/sh
if { [ -n "$KITTY_WINDOW_ID" ] || [ "$TERM" = xterm-kitty ]; } && command -v kitten >/dev/null 2>&1; then
	# Delete all visible images directly; do not start another TTY-aware process.
	printf '\033_Ga=d,d=A\033\\' >/dev/tty
elif [ -n "$FIFO_UEBERZUG" ]; then
	printf '{"action": "remove", "identifier": "PREVIEW"}\n' > "$FIFO_UEBERZUG"
fi
