#!/bin/sh

# File preview handler for lf.

set -C -f
IFS="$(printf '%b_' '\n')"; IFS="${IFS%_}"

image() {
	if [ -f "$1" ] && { [ -n "$KITTY_WINDOW_ID" ] || [ "$TERM" = xterm-kitty ]; } && command -v kitten >/dev/null 2>&1; then
		# Supplying every geometry value keeps icat from querying the TTY. The
		# approximate pixel size only affects scaling; placement uses exact cells.
		cols=$(($2 + $4))
		rows=$(($3 + $5))
		transfer=file
		[ -n "$SSH_TTY" ] && transfer=stream
		timeout 2 kitten icat --silent --stdin=no --engine=builtin \
			--transfer-mode="$transfer" --use-window-size "$cols,$rows,$(($cols*10)),$(($rows*20))" \
			--place "$(($2-1))x$(($3-1))@$4x$5" -- "$1" </dev/null >/dev/tty 2>/dev/null || true
	elif [ -f "$1" ] && [ -n "$DISPLAY" ] && [ -z "$WAYLAND_DISPLAY" ] && command -V ueberzug >/dev/null 2>&1; then
		printf '{"action": "add", "identifier": "PREVIEW", "x": "%s", "y": "%s", "width": "%s", "height": "%s", "scaler": "contain", "path": "%s"}\n' "$4" "$5" "$(($2-1))" "$(($3-1))" "$1" > "$FIFO_UEBERZUG"
	else
		mediainfo "$6"
	fi
}

ifub() {
	[ -n "$KITTY_WINDOW_ID" ] || { [ -n "$DISPLAY" ] && [ -z "$WAYLAND_DISPLAY" ] && command -V ueberzug >/dev/null 2>&1; }
}

# Note that the cache file name is a function of file information, meaning if
# an image appears in multiple places across the machine, it will not have to
# be regenerated once seen.

case "$(file --dereference --brief --mime-type -- "$1")" in
	image/avif) CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/lf/thumb.$(stat --printf '%n\0%i\0%F\0%s\0%W\0%Y' -- "$(readlink -f "$1")" | sha256sum | cut -d' ' -f1)"
		[ ! -f "$CACHE" ] && convert "$1" "$CACHE.jpg"
		image "$CACHE.jpg" "$2" "$3" "$4" "$5" "$1" ;;
	image/*) image "$1" "$2" "$3" "$4" "$5" "$1" ;;
	text/html) lynx -width="$4" -display_charset=utf-8 -dump "$1" ;;
	text/troff) man ./ "$1" | col -b ;;
	text/* | */xml | application/json)
		if command -v bat >/dev/null 2>&1; then bat --terminal-width "$(($4-2))" -f "$1"; else sed -n "1,${3}p" "$1"; fi ;;
	audio/* | application/octet-stream)
		if command -v mediainfo >/dev/null 2>&1; then mediainfo "$1"; else ffprobe -hide_banner -- "$1" 2>&1; fi ;;
	video/* )
		CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/lf/thumb.$(stat --printf '%n\0%i\0%F\0%s\0%W\0%Y' -- "$(readlink -f "$1")" | sha256sum | cut -d' ' -f1)"
		if [ ! -f "$CACHE" ]; then
			if command -v ffmpegthumbnailer >/dev/null 2>&1; then
				ffmpegthumbnailer -i "$1" -o "$CACHE" -s 0
			else
				ffmpeg -loglevel error -ss 1 -i "$1" -frames:v 1 -y "$CACHE"
			fi
		fi
		image "$CACHE" "$2" "$3" "$4" "$5" "$1"
		;;
	*/pdf)
		CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/lf/thumb.$(stat --printf '%n\0%i\0%F\0%s\0%W\0%Y' -- "$(readlink -f "$1")" | sha256sum | cut -d' ' -f1)"
		[ ! -f "$CACHE.jpg" ] && pdftoppm -jpeg -f 1 -singlefile "$1" "$CACHE"
		image "$CACHE.jpg" "$2" "$3" "$4" "$5" "$1"
		;;
	*/epub+zip|*/mobi*)
		CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/lf/thumb.$(stat --printf '%n\0%i\0%F\0%s\0%W\0%Y' -- "$(readlink -f "$1")" | sha256sum | cut -d' ' -f1)"
		[ ! -f "$CACHE.jpg" ] && gnome-epub-thumbnailer "$1" "$CACHE.jpg"
		image "$CACHE.jpg" "$2" "$3" "$4" "$5" "$1"
		;;
	application/*zip) atool --list -- "$1" ;;
	*opendocument*) odt2txt "$1" ;;
	application/pgp-encrypted) gpg -d -- "$1" ;;
esac
exit 1
