/* Default rofi look (dmenu mode, drun fallback), Tokyo Night like dwl/kitty */
configuration {
    font:       "JetBrainsMono Nerd Font 11";
    show-icons: true;
}

* {
    bg:      #1a1b26;
    bg-alt:  #16161e;
    fg:      #a9b1d6;
    fg-dim:  #565f89;
    sel-bg:  #283457;
    sel-fg:  #c0caf5;
    accent:  #7aa2f7;

    background-color: transparent;
    text-color:       @fg;
}

window {
    width:            40%;
    background-color: @bg;
    border:           2px;
    border-color:     @accent;
    border-radius:    6px;
}

mainbox  { padding: 8px; spacing: 8px; }
inputbar { children: [ prompt, entry ]; spacing: 8px; padding: 6px 8px;
           background-color: @bg-alt; border-radius: 4px; }
prompt   { text-color: @accent; }
entry    { placeholder: ""; text-color: @sel-fg; }
listview { lines: 10; scrollbar: false; spacing: 2px; }
element          { padding: 4px 8px; border-radius: 4px; }
element selected { background-color: @sel-bg; text-color: @sel-fg; }
element-text, element-icon { text-color: inherit; }
element-icon     { size: 1.2em; }
