# GNOME-like idle behaviour (values from this laptop's GNOME settings):
# dim shortly before blanking, screen off after 5 min, lock 5 min later,
# suspend after 15 min only on battery. Apps playing video/calls inhibit idle.
timeout 285 'idle-ctl dim' resume 'idle-ctl undim'
timeout 300 'idle-ctl off' resume 'idle-ctl on; idle-ctl undim'
timeout 600 'swaylock -f'
timeout 900 'idle-ctl suspend'
before-sleep 'swaylock -f'
after-resume 'idle-ctl on; idle-ctl undim'
lock 'swaylock -f'
